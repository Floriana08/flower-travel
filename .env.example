# Public map configuration (safe for the browser)
# Recommended Phase 3 provider: MapLibre GL + OpenStreetMap / MapTiler style URL
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional if you later choose Mapbox instead of MapLibre
NEXT_PUBLIC_MAPBOX_TOKEN=

# Never put secret server tokens in NEXT_PUBLIC_* variables
# MAPBOX_SECRET_TOKEN=
