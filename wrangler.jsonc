{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flower-travel",
  "account_id": "83ee682c25e1f0316a8c016de3a237dd",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // Placeholder — replace database_id with the id printed by
  // `wrangler d1 create flower-travel-db`, then run:
  //   npm run db:generate
  //   wrangler d1 migrations apply flower-travel-db --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flower-travel-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
