{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flower-travel",
  "account_id": "83ee682c25e1f0316a8c016de3a237dd",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
  // Note: the D1 "DB" binding is provisioned automatically by the hosting
  // platform from .openai/hosting.json's "d1": "DB" setting. Do not also
  // declare a d1_databases block here — the platform's redirected deploy
  // config (dist/server/wrangler.json) already injects one, and two
  // bindings named "DB" collide at deploy time ("assigned to multiple D1
  // Database bindings").
}
